# Locked dependencies are installed with composer install.
/vendor/

# Runtime data. Keep only reviewed directory guards.
/temp/*
!/temp/.gitignore
/uploads/*
!/uploads/.htaccess
/application/cache/*
!/application/cache/.gitignore
/application/logs/*
!/application/logs/.gitignore
/barcode/qrcode/cache/*
!/barcode/qrcode/cache/.gitignore
/barcode/qrcode/*.dat
/barcode/qrcode/*.tmp*
/assets/da3em/img/uploads/*
!/assets/da3em/img/uploads/.gitignore
/tutorial/visits.txt

# Local credentials, diagnostics, private source backups and editor state.
.env
.env.*
.htpasswd
*.log
*.bak*
*.bkp*
*.PRE_*
*.orig
*.tmp
*.tmp-*
*.pem
*.pfx
*.p12
*.key
*.ora
__pycache__/
*.pyc
.idea/
.claude/
.memory/
.codex/
.agents/
.aws/
node_modules/
Thumbs.db
.DS_Store
perf.data
/database/
/scratch/
/application/modules.zip
/tools/chrome_38.exe
/tools/firefox_33.exe
/PACKAGE-MANIFEST.json
